    "custom/updates": {
        "exec": "~/.local/share/bin/systemupdate.sh",
        "return-type": "json",
        "format": "󰮯 {}",
        "rotate": ${r_deg},
        "on-click": "~/.local/share/bin/systemupdate.sh up",
        "interval": 86400, // once every day
        "tooltip": true,
    },

